# Copy this file to .env and fill in your own credentials.
# Never commit real secrets. See docs/API_SETUP.md for how to get each one.

# --- Map (Leaflet + OpenStreetMap) ---
# No key required — the map works out of the box for everyone.

# --- OpenWeather (free tier) ---
# https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# --- NASA FIRMS (free MAP_KEY) ---
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_NASA_FIRMS_MAP_KEY=

# --- Copernicus Sentinel Hub (OAuth2 client credentials, free tier available) ---
# https://dataspace.copernicus.eu/ -> Sentinel Hub dashboard -> OAuth clients
# Not yet wired into the frontend — see docs/API_SETUP.md for why, and the
# server-side pattern to use if you add it (these must never reach the browser).
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- USGS earthquakes ---
# No key required. Public GeoJSON feed, already live in src/lib/usgs.ts.

# --- Disaster-tweet classifier (ai-service/) ---
# No key required, but the ai-service/ FastAPI backend must be running locally.
# See ai-service/README.md.
VITE_CLASSIFIER_API_URL=http://localhost:8000
